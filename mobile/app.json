{
  "expo": {
    "name": "Kitaplık",
    "slug": "kitaplik",
    "scheme": "kitaplik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitaplik.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Raf fotoğrafı çekmek ve kitap barkodu okumak için kamerayı kullanıyoruz.",
        "NSPhotoLibraryUsageDescription": "Galeriden raf ya da kapak fotoğrafı seçmek için."
      }
    },
    "android": {
      "package": "com.kitaplik.app",
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Raf fotoğrafı çekmek ve kitap barkodu okumak için kamerayı kullanıyoruz.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2F4A3A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
