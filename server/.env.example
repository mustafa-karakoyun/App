# Sunucu
PORT=3000
# Telefonun sunucuya ulaşacağı adres; yüklenen kapak görsellerinin URL'si buna göre üretilir.
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgres://kitaplik:kitaplik@localhost:5432/kitaplik
# Uzun ve rastgele bir değer verin: openssl rand -hex 32
JWT_SECRET=degistir-beni

# Raf tarama: "openai" ya da anahtar yokken denemek için "mock"
VISION_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1
# Ücretsiz planda aylık raf tarama limiti
SCAN_MONTHLY_LIMIT=20

# İsteğe bağlı: anahtarsız Google Books istekleri düşük kotayla sınırlı
GOOGLE_BOOKS_API_KEY=

# Google ile giriş (boşsa kapalı). Virgülle ayrılmış OAuth istemci kimlikleri (iOS, Android, Web).
GOOGLE_CLIENT_IDS=
